  // 生成提交信息的风格要求
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "使用简体中文，遵循 Conventional Commits 格式（如 feat: / fix: / refactor:），首行不超过 72 个字符，只输出提交信息本身，不要输出任何解释或代码块标记。"
    }
  ]
}
